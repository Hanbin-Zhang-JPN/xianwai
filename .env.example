# Optional. Without a key the app stays in clearly labelled local trial mode.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# For a phone accessing an independently deployed HTTPS backend, configure a token.
# The local server binds to 127.0.0.1 by default.
API_TOKEN=
PORT=4388
HOST=127.0.0.1
